FROM node:20-alpine

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package*.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/

RUN npm install

# Copy source files
COPY . .

EXPOSE 4000

CMD ["npm", "run", "--workspace=@stashbox/api", "dev"]